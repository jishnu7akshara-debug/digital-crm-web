# Digital Footprint OS - Environment Configuration Example

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME="Digital Footprint OS"
APP_DOMAIN=crm.digitalfootprint.in
FRONTEND_URL=http://localhost:3000
API_V1_PREFIX=/api/v1
SECRET_KEY=generate-a-secure-random-64-character-string-for-production
SESSION_COOKIE_NAME=df_session
SESSION_EXPIRE_DAYS=7
SECURE_COOKIES=false # Set true in production

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 15+)
# -----------------------------------------------------------------------------
# Pooled connection string for the FastAPI runtime (e.g. Supabase, Neon, PgBouncer)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/digitalfootprint_os
# Direct unpooled connection string for Alembic migrations
DATABASE_DIRECT_URL=postgresql+psycopg://postgres:password@localhost:5432/digitalfootprint_os
# Fallback local sqlite for development/testing if PostgreSQL is not available
SQLITE_FALLBACK=true

# -----------------------------------------------------------------------------
# S3-Compatible Private File Storage (AWS S3, Cloudflare R2, MinIO)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=s3 # or local
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=df-crm-assets
S3_REGION=auto
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# -----------------------------------------------------------------------------
# Email Provider (Resend / SMTP)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp # or resend, console
RESEND_API_KEY=re_your_api_key_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@digitalfootprint.in
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=notifications@digitalfootprint.in
SMTP_FROM_NAME="Digital Footprint OS"

# -----------------------------------------------------------------------------
# Redis (Optional: for distributed rate-limiting & cache)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Super Admin Initial Seed Credentials
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@digitalfootprint.in
SUPER_ADMIN_PASSWORD=ChangeMeInProduction123!
SUPER_ADMIN_NAME="System Super Admin"

