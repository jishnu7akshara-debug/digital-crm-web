# =============================================================================
# Digital Footprint OS - Unified Single Deployment Environment Variables
# Single Origin: Next.js Web Frontend + FastAPI Backend
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Application & Single-Origin Configuration
# -----------------------------------------------------------------------------
APP_ENV=production
APP_NAME="Digital Footprint OS"
APP_DOMAIN=crm.digitalfootprint.in
FRONTEND_URL=https://crm.digitalfootprint.in
API_V1_PREFIX=/api/v1
APP_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# 2. Authentication & Session Security (Argon2id + HTTP-Only Cookies)
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=c4fbf04ad9817164448b4fea383970570a9fb026a766c5bb86ee05ea6f25ec11
SESSION_COOKIE_NAME=df_session
SESSION_EXPIRE_DAYS=7
SECURE_COOKIES=true
COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL 15+ / Neon Serverless)
# -----------------------------------------------------------------------------
# Use postgresql+psycopg:// for Linux/Docker/Vercel (or postgresql+pg8000:// for Windows local)
DATABASE_URL=postgresql+psycopg://username:password@your-postgres-host:5432/neondb?sslmode=require
DATABASE_DIRECT_URL=postgresql+psycopg://username:password@your-postgres-host:5432/neondb?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg://username:password@your-postgres-host:5432/dcrm_test?sslmode=require

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
SQLITE_FALLBACK=false

# -----------------------------------------------------------------------------
# 4. Storage Provider (Cloudflare R2, AWS S3, or Local Uploads)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads

# If STORAGE_PROVIDER=s3, configure the S3/R2 bucket below:
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET_NAME=df-crm-assets
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your-s3-access-key-id
# S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# -----------------------------------------------------------------------------
# 5. Email Notifications (SMTP / Resend / Console)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@digitalfootprint.in
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=notifications@digitalfootprint.in
SMTP_FROM_NAME="Digital Footprint OS"
# RESEND_API_KEY=re_your_api_key_here

# -----------------------------------------------------------------------------
# 6. Initial Seed Super Administrator Credentials
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@digitalfootprint.in
SUPER_ADMIN_PASSWORD=Admin@123456!
SUPER_ADMIN_NAME="System Super Admin"

# -----------------------------------------------------------------------------
# 7. Frontend Internal Proxy (Next.js Single Deployment)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Digital Footprint OS"
NEXT_PUBLIC_API_BACKEND_URL=http://127.0.0.1:8000
