{
  "name": "digitalfootprint-os",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "description": "Digital Footprint OS: Enterprise Unified Monolith (Next.js 15 + FastAPI)",
  "scripts": {
    "dev:web": "pnpm --filter digitalfootprint-web dev",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "dev": "pnpm --filter digitalfootprint-web dev",
    "build:web": "pnpm --filter digitalfootprint-web build",
    "build": "pnpm --filter digitalfootprint-web build",
    "start": "pnpm --filter digitalfootprint-web start",
    "lint": "pnpm --filter digitalfootprint-web lint",
    "test": "cd apps/api && pytest"
  },
  "dependencies": {
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "next": "^15.1.3"
  },
  "workspaces": [
    "apps/*"
  ]
}
